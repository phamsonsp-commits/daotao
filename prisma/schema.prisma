// Prisma schema for the internal training platform (đào tạo nội bộ)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Cấp độ nhân sự, dùng để phân loại tài liệu / chương trình đào tạo / bài đánh giá
enum Level {
  INTERN // Thực tập sinh
  STAFF // Nhân viên
  SENIOR // Nhân viên cao cấp / Chuyên viên
  MANAGER // Quản lý / Trưởng nhóm
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum DocumentCategory {
  QUY_CHE // Quy chế
  QUY_TRINH // Quy trình
  SAN_PHAM // Tài liệu sản phẩm
  CONG_TY // Tài liệu về công ty
}

enum ProgramStatus {
  DRAFT
  PUBLISHED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTI_CHOICE
}

enum EnrollmentStatus {
  IN_PROGRESS
  COMPLETED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(EMPLOYEE)
  level        Level    @default(STAFF)
  department   String?
  createdAt    DateTime @default(now())

  createdDocuments Document[]        @relation("DocumentCreatedBy")
  createdPrograms  TrainingProgram[] @relation("ProgramCreatedBy")
  createdQuizzes   Quiz[]            @relation("QuizCreatedBy")
  enrollments      Enrollment[]
  quizAttempts     QuizAttempt[]
}

model Document {
  id          String           @id @default(cuid())
  title       String
  category    DocumentCategory
  level       Level            @default(STAFF)
  tags        String           @default("") // comma-separated
  summary     String           @default("")
  content     String // markdown
  version     String           @default("1.0")
  createdBy   User             @relation("DocumentCreatedBy", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  programItems ProgramItem[]

  @@index([category])
  @@index([level])
}

model TrainingProgram {
  id          String        @id @default(cuid())
  title       String
  description String        @default("")
  level       Level         @default(STAFF)
  status      ProgramStatus @default(DRAFT)
  autoGenerated Boolean     @default(false)
  createdBy   User          @relation("ProgramCreatedBy", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  items       ProgramItem[]
  quizzes     Quiz[]
  enrollments Enrollment[]
}

model ProgramItem {
  id         String          @id @default(cuid())
  program    TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId  String
  document   Document        @relation(fields: [documentId], references: [id])
  documentId String
  order      Int             @default(0)

  @@unique([programId, documentId])
}

model Quiz {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  level       Level    @default(STAFF)
  passScore   Int      @default(70) // % required to pass
  program     TrainingProgram? @relation(fields: [programId], references: [id])
  programId   String?
  createdBy   User     @relation("QuizCreatedBy", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())

  questions Question[]
  attempts  QuizAttempt[]
}

model Question {
  id            String       @id @default(cuid())
  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId        String
  text          String
  type          QuestionType @default(SINGLE_CHOICE)
  options       String // JSON array of strings
  correctIndexes String // JSON array of ints
  order         Int          @default(0)
}

model QuizAttempt {
  id          String   @id @default(cuid())
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId      String
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  answers     String // JSON: { [questionId]: number[] }
  score       Int // percentage 0-100
  passed      Boolean
  submittedAt DateTime @default(now())
}

model Enrollment {
  id             String           @id @default(cuid())
  user           User             @relation(fields: [userId], references: [id])
  userId         String
  program        TrainingProgram  @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId      String
  status         EnrollmentStatus @default(IN_PROGRESS)
  completedItems String           @default("[]") // JSON array of ProgramItem ids
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, programId])
}
